{
  "name": "@mock-mcp/v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server v1: mock_mcp — Enterprise Operations Hub (mcp-use@1.x, legacy protocol)",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "prebuild": "pnpm --filter @mock-mcp/shared build",
    "build": "mcp-use build",
    "predev": "pnpm --filter @mock-mcp/shared build",
    "dev": "mcp-use dev --port 8760",
    "prestart": "pnpm --filter @mock-mcp/shared build",
    "start": "mcp-use start --port 8760",
    "prestart:multi": "pnpm --filter @mock-mcp/shared build",
    "start:multi": "tsx cli.ts",
    "postinstall": "mcp-use generate-types || exit 0"
  },
  "dependencies": {
    "@mock-mcp/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/apps-sdk-ui": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "mcp-use": "1.32.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "tailwindcss": "^4.2.0",
    "vite": "^8.2.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
