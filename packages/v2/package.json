{
  "name": "@mock-mcp/v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MCP 2026 Enterprise Operations Hub",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "predev": "pnpm --filter @mock-mcp/shared build && pnpm --filter @mock-mcp/supervisor build",
    "dev": "mcp-use dev --port 8770",
    "prebuild": "pnpm --filter @mock-mcp/shared build && pnpm --filter @mock-mcp/supervisor build",
    "build": "mcp-use build",
    "prebuild:inspector": "pnpm --filter @mock-mcp/shared build && pnpm --filter @mock-mcp/supervisor build",
    "build:inspector": "mcp-use build && node -e \"require('node:fs').writeFileSync('.mcp-use/build/inspector.json', JSON.stringify({ includeInspector: true }))\"",
    "prerun": "pnpm --filter @mock-mcp/shared build && pnpm --filter @mock-mcp/supervisor build",
    "run": "tsx cli.ts run",
    "prestart": "pnpm --filter @mock-mcp/shared build && pnpm --filter @mock-mcp/supervisor build",
    "start": "tsx cli.ts start",
    "stop": "tsx cli.ts stop",
    "status": "tsx cli.ts status",
    "typecheck": "mcp-use typecheck",
    "pretest": "pnpm run build:inspector",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@mock-mcp/shared": "workspace:*",
    "@mock-mcp/supervisor": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "mcp-use": "2.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.0",
    "vite": "^8.2.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
