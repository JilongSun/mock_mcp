{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.ts", "cli.ts", "src/**/*", "views/**/*", "mcp-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
